function filtered(){
  let r=P.filter(p=>{
    if(filt.cat && p.cat!==filt.cat) return false;
    const ss=p.sizes.filter(s=>!filt.stock||s[1]).map(s=>s[0]);
    if(filt.cl.length && !filt.cl.some(s=>ss.includes(s))) return false;
    if(filt.sh.length && !filt.sh.some(s=>ss.includes(s))) return false;
    if(p.price<filt.min||p.price>filt.max) return false;
    if(filt.stock && !p.sizes.some(s=>s[1])) return false;
    return true;
  });
  if(filt.sort==='asc') r.sort((a,b)=>a.price-b.price);
  else if(filt.sort==='desc') r.sort((a,b)=>b.price-a.price);
  else r.sort((a,b)=>b.t-a.t);
  return r;
}
