let rainRAF=0;
function startRain(){
  cancelAnimationFrame(rainRAF);
  const c=$('#irain'); if(!c||matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const ctx=c.getContext('2d'), dpr=Math.min(2,devicePixelRatio||1);
  let W,H; const size=()=>{W=c.clientWidth;H=c.clientHeight;c.width=W*dpr;c.height=H*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);}; size();
  const small=W<500;
  const mk=(n,lmin,lmax,vmin,vmax,amin,amax,w)=>Array.from({length:n},()=>({x:Math.random()*W*1.15,y:Math.random()*H,l:lmin+Math.random()*(lmax-lmin),v:vmin+Math.random()*(vmax-vmin),a:amin+Math.random()*(amax-amin),w}));
  const drops=[...mk(small?50:90,8,14,6,9,.04,.09,.6),...mk(small?32:60,14,24,10,14,.06,.13,.9),...mk(small?10:18,24,38,15,20,.08,.18,1.2)];
  const ripples=[];
  const tick=()=>{
    rainRAF=requestAnimationFrame(tick);
    const intro=$('#intro'); if(!intro){cancelAnimationFrame(rainRAF);return;}
    if(intro.classList.contains('off')||document.hidden) return;
    if(c.clientWidth!==W||c.clientHeight!==H) size();
    ctx.clearRect(0,0,W,H); ctx.lineCap='round';
    const floor=H*.74, top=H*.06;
    for(const d of drops){
      d.y+=d.v; d.x-=d.v*.1;
      if(d.y>floor+Math.random()*H*.2){ if(d.w>.8&&ripples.length<30&&Math.abs(d.x-W/2)<W*.35) ripples.push({x:d.x,y:d.y,r:1,a:.3}); d.y=-20-Math.random()*60; d.x=Math.random()*W*1.15; }
      const dy=Math.max(0,d.y-top), dx=Math.abs(d.x-W/2)/(W*.05+dy*.42), lit=dx<1?1+(1-dx)*3:1;
      ctx.lineWidth=d.w; ctx.strokeStyle=`rgba(70,74,82,${Math.min(.55,d.a*lit*1.3).toFixed(3)})`;
      ctx.beginPath(); ctx.moveTo(d.x,d.y); ctx.lineTo(d.x+d.l*.1,d.y-d.l); ctx.stroke();
    }
    for(let i=ripples.length-1;i>=0;i--){ const p=ripples[i]; p.r+=.5; p.a*=.92; if(p.a<.02){ripples.splice(i,1);continue;}
      ctx.strokeStyle=`rgba(70,74,82,${p.a.toFixed(3)})`; ctx.lineWidth=.7; ctx.beginPath(); ctx.ellipse(p.x,p.y,p.r*2.2,p.r*.5,0,0,6.283); ctx.stroke(); }
  };
