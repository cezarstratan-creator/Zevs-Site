.i-scene{position:absolute;left:50%;top:0;width:max(100vw,calc(100svh * .5625));aspect-ratio:1152/2048;transform:translateX(-50%);pointer-events:none;overflow:hidden}
.i-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform-origin:50% 8%;transform:scale(calc(1.0 + var(--p) * .06))}
