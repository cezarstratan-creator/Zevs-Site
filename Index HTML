}
function toastAdd(p,size){
  const t=$('#toast'); t.innerHTML=`<img src="${IMG[p.img[0]]}" alt=""><span><b>Adăugat în coș</b><small>${esc(p.name)} · ${size}</small></span><button type="button" id="toastCart">Vezi coșul</button>`;
  t.classList.add('on','rich'); clearTimeout(tt); tt=setTimeout(()=>t.classList.remove('on'),3200);
  $('#toastCart').onclick=()=>{t.classList.remove('on'); renderCart(); open($('#cart'));};
}

let ticking=false;
function onScroll(){
  ticking=false;
  const hdr=$('#hdr'), intro=$('#intro');
  if(intro){
    const h=intro.offsetHeight, p=Math.min(1,Math.max(0,scrollY/(h*.85)));
    intro.style.setProperty('--p',p.toFixed(3));
    intro.classList.toggle('off',p>=1);
    const hb=$('#hb'); const clear=hb?hb.getBoundingClientRect().top>hdr.offsetHeight+2:scrollY<h-60;
    hdr.classList.toggle('clear',clear);
    hdr.classList.toggle('b',!clear);
  } else { hdr.classList.remove('clear'); hdr.classList.toggle('b',scrollY>4); }
}
addEventListener('scroll',()=>{ if(!ticking){ticking=true; requestAnimationFrame(onScroll);} },{passive:true});
addEventListener('resize',()=>requestAnimationFrame(onScroll));
document.addEventListener('click',e=>{const b=e.target.closest('[data-scroll]'); if(!b) return; const hb=$('#hb'); if(hb) scrollTo({top:hb.getBoundingClientRect().top+scrollY-($('#hdr').offsetHeight)+14,behavior:'smooth'});});
$('#loadEm').innerHTML=emblem3d();
renderCart(); render();
</script>

