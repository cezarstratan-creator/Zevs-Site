let spinRAF=0;
function initSpin(){
  cancelAnimationFrame(spinRAF);
  const em=$('#intro .i-em'), rot=em&&em.querySelector('.rot'); if(!rot) return;
  const sparks=[...em.querySelectorAll('.sp i')];
  const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
  const AUTO=360/6.5;               // grade pe secundă
  let ang=0, tilt=0, vel=0, drag=false, lx=0, ly=0, lt=0, last=performance.now();
  const apply=()=>{ rot.style.transform=`rotateX(${tilt.toFixed(2)}deg) rotateY(${ang.toFixed(2)}deg)`; for(const i of sparks) i.style.transform=`rotateY(${(-ang).toFixed(2)}deg)`; };
  const tick=now=>{
    spinRAF=requestAnimationFrame(tick);
    const dt=Math.min(.05,(now-last)/1000); last=now;
    const intro=$('#intro'); if(!intro){cancelAnimationFrame(spinRAF);return;}
    if(document.documentElement.classList.contains('sp-hold')){ ang=0; apply(); return; }
    if(intro.classList.contains('off')||document.hidden) return;
    if(!drag){
      ang+=(reduce?0:AUTO)*dt+vel*dt;
      vel*=Math.pow(.04,dt);                 // inerție care se stinge
      if(Math.abs(vel)<2) vel=0;
      tilt+=(0-tilt)*Math.min(1,dt*4);
    }
    apply();
  };
  const down=e=>{ drag=true; em.classList.add('grab'); lx=e.clientX; ly=e.clientY; lt=performance.now(); vel=0; try{em.setPointerCapture(e.pointerId)}catch(_){} };
  const move=e=>{ if(!drag) return; const now=performance.now(), dx=e.clientX-lx, dy=e.clientY-ly, dts=Math.max(.008,(now-lt)/1000);
    ang+=dx*.55; tilt=Math.max(-35,Math.min(35,tilt-dy*.35)); vel=dx*.55/dts; lx=e.clientX; ly=e.clientY; lt=now; apply(); };
  const up=()=>{ if(!drag) return; drag=false; em.classList.remove('grab'); vel=Math.max(-1400,Math.min(1400,vel)); };
  em.addEventListener('pointerdown',down); em.addEventListener('pointermove',move);
  em.addEventListener('pointerup',up); em.addEventListener('pointercancel',up); em.addEventListener('lostpointercapture',up);
  apply(); spinRAF=requestAnimationFrame(tick);
}
