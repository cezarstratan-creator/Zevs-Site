let introPlayed=false, dustRAF=0;
function startIntro(){
  const intro=$('#intro'); if(!intro) return;
  const img=intro.querySelector('.i-img');
  let did=false; const go0=()=>{ if(did) return; did=true; requestAnimationFrame(()=>intro.classList.add('go')); introPlayed=true; startDust(); };
  const go=()=>splashDone.then(go0);
  if(img.complete) go(); else { img.addEventListener('load',go,{once:true}); setTimeout(go,1500); }
}
function startDust(){
  cancelAnimationFrame(dustRAF);
  const c=$('#dust'); if(!c||matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const ctx=c.getContext('2d'); const dpr=Math.min(2,devicePixelRatio||1);
  let W,H; const size=()=>{W=c.clientWidth;H=c.clientHeight;c.width=W*dpr;c.height=H*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);}; size();
  const N=W<500?34:60;
  const P=Array.from({length:N},()=>({x:Math.random(),y:Math.random(),r:.4+Math.random()*1.4,vx:(Math.random()-.5)*.00025,vy:-.00008-Math.random()*.00022,ph:Math.random()*6.28}));
  const t0=performance.now();
  const tick=t=>{
    dustRAF=requestAnimationFrame(tick);
    const intro=$('#intro'); if(!intro){cancelAnimationFrame(dustRAF);return;}
    if(intro.classList.contains('off')||document.hidden) return;
    if(c.clientWidth!==W) size();
    const fade=Math.min(1,Math.max(0,(t-t0-1800)/1500));
    ctx.clearRect(0,0,W,H);
    for(const p of P){
      p.x+=p.vx+Math.sin(t/2400+p.ph)*.00012; p.y+=p.vy;
      if(p.y<0){p.y=1;p.x=Math.random();} if(p.x<0)p.x=1; if(p.x>1)p.x=0;
      const half=.06+p.y*.44, d=Math.abs(p.x-.5)/half;      // în interiorul conului
      if(d>1) continue;
      const a=(1-d)*(1-p.y*.7)*fade*(.45+.35*Math.sin(t/700+p.ph));
      ctx.globalAlpha=Math.max(0,a)*1.2; ctx.fillStyle='#fff';
      ctx.beginPath(); ctx.arc(p.x*W,p.y*H,p.r,0,6.283); ctx.fill();
    }
  };
  dustRAF=requestAnimationFrame(tick);
}
