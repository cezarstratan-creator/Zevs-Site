ZEVS – site + comenzi pe Telegram 
=================================
Conținut:
  index.html                     – site-ul
  netlify/functions/order.mjs    – primește comenzile, le numerotează (ZV-1, ZV-2…) și le trimite pe Telegram
  package.json, netlify.toml     – setări pentru Netlify

Variabile secrete (Netlify → Site configuration → Environment variables):
  TELEGRAM_BOT_TOKEN = tokenul de la @BotFather
  TELEGRAM_CHAT_ID   = ID-ul tău (sau al grupului) unde vin comenzile

Tokenul NU se scrie niciodată în fișiere și nu se trimite nimănui.

<!doctype html>
<html lang="ro">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#000000">
<meta name="description" content="ZEVS – haine și încălțăminte în Chișinău. Livrare în toată Moldova.">
<title>ZEVS</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Epilogue:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap">
<style>
/* Layout: replica of zevs-store mobile UI; 24px gutters, 2-col product grid (4 on desktop), drawers: menu left, cart full/right, filters bottom sheet */
:root{
  --bg:#ffffff;
  --fg:#111111;
  --ink:#141414;
  --soft:#f3f2ef;
  --field:#eeede9;
  --line:#e4e3df;
  --muted:#6b6b68;
  --mute2:#8d8c88;
  --black:#000000;
  --serif:"Cormorant Garamond", Georgia, "Times New Roman", serif;
  --sans:"Epilogue", "Helvetica Neue", Arial, sans-serif;
  --sys:-apple-system, BlinkMacSystemFont, "SF Pro Text", "Inter", "Helvetica Neue", Arial, sans-serif;
  --pad:24px;
  --hdr:62px;
  --ease:cubic-bezier(.22,.61,.36,1);
  color-scheme:light;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
[hidden]{display:none!important}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--sans);font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
body.lock{overflow:hidden}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer}
img{display:block;max-width:100%}
input,select,textarea{font:inherit}
:focus-visible{outline:2px solid var(--fg);outline-offset:2px}
.wrap{max-width:1440px;margin:0 auto;padding-inline:var(--pad)}
.serif{font-family:var(--serif)}
.u{text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:1px}

/* header */
.hdr{position:sticky;top:env(safe-area-inset-top,0px);z-index:40;background:#fff;border-bottom:1px solid transparent;transition:border-color .25s}
.hdr.b{border-bottom-color:var(--line)}
.hdr-in{height:var(--hdr);display:grid;grid-template-columns:1fr auto 1fr;align-items:center;max-width:1100px;margin:0 auto;padding-inline:14px}
.hl{display:flex;align-items:center}
.hr{display:flex;justify-content:flex-end}
.ib{width:42px;height:42px;display:grid;place-items:center;position:relative}
.ib svg{width:23px;height:23px}
.logo{font-family:var(--serif);font-weight:600;font-size:27px;letter-spacing:.2em;line-height:1;padding-left:.2em;color:#111}
.hdr .logo{font-weight:700}
.badge{position:absolute;top:3px;right:2px;min-width:16px;height:16px;border-radius:8px;background:#111;color:#fff;font:600 10px/16px var(--sys);text-align:center;padding:0 4px;border:1.5px solid #fff;box-sizing:content-box;transform:scale(0);transition:transform .3s var(--ease)}
.badge.on{transform:scale(1)}
.hdr.co .hr{visibility:hidden}

/* loader */
.loader{position:fixed;inset:0;z-index:100;background:#fff;display:grid;place-items:center;opacity:0;pointer-events:none;transition:opacity .25s}
.loader.on{opacity:1;pointer-events:auto}
.spin{perspective:900px}
.spin .e3{--w:min(250px,62vw)}
.spin .e3{--d:2.4s}
.spin .e3 .rot{animation-duration:2.4s}
@keyframes spinY{from{transform:rotateY(0)}to{transform:rotateY(360deg)}}
#page{transition:opacity .3s var(--ease)}
#page.out{opacity:0}

/* hero */
.hero{display:grid;place-items:center;height:260px;perspective:1100px;overflow:hidden}
.e3{--w:min(300px,74vw);width:var(--w);aspect-ratio:838/425;transform-style:preserve-3d;transform:rotateX(14deg) rotateZ(-6deg)}
.e3 .rot{position:absolute;inset:0;transform-style:preserve-3d;animation:spinY var(--d,6.5s) linear infinite;will-change:transform}
.e3 img{position:absolute;inset:0;width:100%;height:100%;backface-visibility:visible;-webkit-user-drag:none;user-select:none}
.e3 img.f{filter:grayscale(1) contrast(1.55) brightness(1.18)}
.e3 img.in{filter:grayscale(1) brightness(.55) contrast(1.3)}
.e3 img.rim{filter:grayscale(1) brightness(1.05) contrast(1.6)}
/* reflex cromat care alunecă pe suprafață */
.e3 .sh{position:absolute;inset:0;-webkit-mask-size:100% 100%;mask-size:100% 100%;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat;
  background:linear-gradient(110deg,transparent 0 38%,rgba(255,255,255,.0) 40%,rgba(255,255,255,.95) 48%,rgba(210,225,240,.7) 51%,rgba(255,255,255,0) 58%,transparent 100%) 0 0/300% 100% no-repeat;
  animation:sheen var(--d,6.5s) linear infinite;pointer-events:none}
@keyframes sheen{0%{background-position:120% 0}22%{background-position:-20% 0}100%{background-position:-20% 0}}
.e3 .sh.b{animation-delay:calc(var(--d,6.5s) / -2)}
/* sclipire la colț */
.e3 .sp{position:absolute;width:0;height:0;transform-style:preserve-3d}
.e3 .sp i{position:absolute;left:-21px;top:-21px;width:42px;height:42px;display:block;animation:faceY var(--d,6.5s) linear infinite}
.e3 .sp svg{width:100%;height:100%;opacity:0;transform:scale(.2) rotate(0deg);animation:twinkle var(--d,6.5s) ease-out infinite;filter:drop-shadow(0 0 1.5px rgba(0,0,0,.55)) drop-shadow(0 0 5px rgba(120,140,170,.75)) drop-shadow(0 0 10px rgba(255,255,255,1))}
.e3 .sp.s2 svg{animation-delay:calc(var(--d,6.5s) / -2)}
@keyframes faceY{from{transform:rotateY(0)}to{transform:rotateY(-360deg)}}
@keyframes twinkle{0%,19%{opacity:0;transform:scale(.2) rotate(0)}24%{opacity:1;transform:scale(1.15) rotate(45deg)}27%{opacity:.9;transform:scale(.8) rotate(70deg)}33%,100%{opacity:0;transform:scale(.2) rotate(110deg)}}

/* section heads */
.sh{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:16px}
.h2{font-family:var(--serif);font-weight:700;font-size:24px;line-height:1.1;text-transform:uppercase;margin:0;letter-spacing:.005em}
.more{font-size:15px;text-decoration:underline;text-underline-offset:4px;text-decoration-thickness:1px}
.sub{color:var(--muted);font-size:17px;margin:6px 0 0;line-height:1.4}
.sec{padding-top:26px}

/* product grid + card */
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.pc{display:block;min-width:0;padding-bottom:22px}
.pi{aspect-ratio:246/314;border-radius:7px;overflow:hidden;background:var(--soft);max-width:100%}
.pi img{width:100%;height:100%;object-fit:cover;transition:transform .7s var(--ease)}
.pc:hover .pi img{transform:scale(1.03)}
.pn{font:400 15.5px/1.3 var(--sys);color:#1c1c1c;margin:22px 0 0 4px;letter-spacing:-.005em}
.pp{font:300 16px/1.3 var(--sys);color:#4c4c4a;margin:12px 0 0 4px;font-variant-numeric:tabular-nums;letter-spacing:.005em}
.chips{display:flex;flex-wrap:wrap;gap:5px;margin:12px 0 0 4px}
.chip{min-width:23px;height:23px;padding:0 6px;border-radius:12px;border:1px solid #dcdbd7;font:600 8.5px/21px var(--sys);text-align:center;color:#111;background:#fff}
.chip.off{color:#c9c8c4;text-decoration:line-through}
.btn{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;height:48px;border-radius:8px;background:var(--ink);color:#fff;font:700 14px/1 var(--sys);letter-spacing:.01em;text-transform:uppercase;transition:background .25s,transform .2s}
.btn:active{transform:scale(.985)}
.btn:hover{background:#2a2a2a}
.btn.big{height:57px;font:700 17.5px/1 var(--sans);text-transform:none;letter-spacing:-.005em}
.btn.wh{background:#fff;color:#111}
.btn.gray{background:#6f6f6f;pointer-events:none}
.btn svg{flex:none}

/* categories */
.cats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.cat{position:relative;height:197px;border-radius:12px;overflow:hidden;background:radial-gradient(120% 90% at 50% 25%,#2b2b2b 0%,#121212 55%,#0a0a0a 100%);color:#fff;display:block;transition:transform .4s var(--ease)}
.cat:hover{transform:translateY(-2px)}
.cat svg{position:absolute;left:50%;top:38px;transform:translateX(-50%);width:50px;height:50px}
.cat b{position:absolute;left:20px;bottom:38px;font:700 17px/1 var(--sans)}
.cat span{position:absolute;left:20px;bottom:16px;font:400 13px/1 var(--sans);color:#a3a29e}

/* stats */
.stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:34px}
.st{background:var(--soft);border-radius:10px;padding:22px 20px 22px}
.st svg{width:22px;height:22px;stroke:#111}
.st b{display:block;font:700 23px/1 var(--serif);margin-top:30px;letter-spacing:.01em;font-variant-numeric:oldstyle-nums}
.st span{display:block;color:var(--muted);font-size:15.5px;margin-top:8px}
.st.c b{font-size:25px;margin-top:20px;font-weight:700}

/* telegram promo */
.tg{position:relative;margin-top:16px;border-radius:12px;overflow:hidden;color:#fff;padding:26px 12px 52px;min-height:345px;
  background:
   radial-gradient(60% 45% at 78% 15%, rgba(255,255,255,.06), transparent 70%),
   radial-gradient(90% 60% at 20% 105%, #262626 0%, transparent 60%),
   repeating-linear-gradient(115deg, rgba(255,255,255,.025) 0 2px, transparent 2px 7px),
   linear-gradient(160deg,#1a1a1a 0%,#0c0c0c 45%,#151515 75%,#0b0b0b 100%)}
.tg::before{content:"";position:absolute;inset:0;background:
   radial-gradient(70% 30% at 70% 60%, rgba(255,255,255,.05), transparent 70%),
   radial-gradient(40% 25% at 30% 40%, rgba(255,255,255,.04), transparent 70%);pointer-events:none}
.tg .orb{position:absolute;right:30px;top:12px;width:100px;height:100px;border-radius:50%;background:radial-gradient(circle,rgba(150,200,255,.28) 0%,rgba(90,140,200,.14) 55%,rgba(0,0,0,0) 72%);box-shadow:0 0 40px rgba(130,180,255,.15) inset;display:grid;place-items:center}
.tg .orb svg{width:44px;height:44px;filter:drop-shadow(0 0 10px rgba(170,210,255,.7))}
.tg .wm{position:absolute;right:36px;bottom:40px;font:600 30px/1 var(--serif);letter-spacing:.35em;color:rgba(200,200,200,.42);transform:rotate(38deg);transform-origin:right bottom;text-shadow:0 1px 0 rgba(0,0,0,.6),0 -1px 0 rgba(255,255,255,.15)}
.tg small{position:relative;display:block;font:500 11px/1 var(--sans);letter-spacing:.35em;color:#cfcfcf}
.tg h3{position:relative;margin:22px 0 0;font:600 35px/1.03 var(--serif);text-transform:uppercase;letter-spacing:.01em}
.tg p{position:relative;margin:14px 0 0;font-size:14.5px;line-height:1.38;color:#dedede;max-width:205px}
.tg a.tb{position:relative;display:inline-flex;align-items:center;gap:10px;margin-top:16px;height:45px;padding:0 15px 0 12px;border-radius:7px;background:#fff;color:#111;font:700 13.5px/1 var(--sans)}
.tg .mem{position:relative;display:flex;align-items:center;gap:8px;margin-top:22px;font-size:11.5px;color:#cfcfcf}

/* reviews */
.revs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:22px}
.rv{border-radius:8px;overflow:hidden;background:#000;display:flex;flex-direction:column;height:167px}
.rv img{width:100%;height:110px;object-fit:cover}
.rv span{flex:1;padding:7px 7px 0;color:#fff;font:400 11px/1.2 var(--sans)}
.tags{display:flex;justify-content:center;flex-wrap:wrap;margin-top:14px;font-size:12.5px;color:var(--muted)}
.tags span{padding:0 12px;border-left:1px solid #cfcfcb}
.tags span:first-child{border-left:0}

/* footer */
.ftr{background:#000;color:#fff;text-align:center;padding:70px var(--pad) 90px;margin-top:52px}
.ftr .logo{color:#fff;font-size:28px}
.ftr p{margin:14px 0 0;color:#b5b4b0;font-size:15px}
.soc{display:flex;justify-content:center;gap:12px;margin-top:30px}
.soc a{width:44px;height:44px;border-radius:50%;border:1px solid #3a3a3a;display:grid;place-items:center;transition:border-color .2s,background .2s}
.soc a:hover{border-color:#777}
.soc svg{width:20px;height:20px}
.ftr .cp{margin-top:44px;color:#6d6d6a;font-size:11.5px;line-height:2}
.ftr .cp a{text-decoration:underline;text-underline-offset:3px}

/* overlay & drawers */
.scrim{position:fixed;inset:0;z-index:60;background:rgba(20,20,20,.45);backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px);opacity:0;pointer-events:none;transition:opacity .35s var(--ease)}
.scrim.on{opacity:1;pointer-events:auto}
.menu{position:fixed;left:0;top:0;bottom:0;z-index:70;width:75%;max-width:420px;background:#fff;display:flex;flex-direction:column;transform:translateX(-100%);transition:transform .45s var(--ease);padding-top:env(safe-area-inset-top,0px)}
.menu.on{transform:none}
.mh{display:flex;justify-content:space-between;align-items:center;height:72px;padding:0 22px;border-bottom:1px solid var(--line)}
.mh .logo{font-size:30px;padding-left:0}
.mh .ib svg{width:20px;height:20px}
.eb{font:500 10.5px/1 var(--sans);letter-spacing:.32em;color:#555;text-transform:uppercase}
.mb{padding:20px 22px 0;flex:1;display:flex;flex-direction:column}
.mnav{list-style:none;margin:16px 0 0;padding:0}
.mnav a{display:flex;justify-content:space-between;align-items:center;height:54px;border-bottom:1px solid var(--line);font:700 22px/1 var(--serif);-webkit-text-stroke:.35px currentColor;text-transform:uppercase;letter-spacing:.01em;transition:padding .25s}
.mnav a:hover{padding-left:4px}
.mnav svg{width:20px;height:20px;color:#444}
.mt{margin-top:auto;padding-bottom:26px;text-align:center}
.mt .eb{letter-spacing:.34em;color:#444}
.mt i{display:block;width:44px;height:1px;background:#d6d5d1;margin:12px auto 0}
.mt .soc{gap:14px;margin-top:22px}
.mt .soc a{width:38px;height:38px;border-color:#dcdbd7}
.mt .soc svg{width:17px;height:17px}
.mf{border-top:1px solid var(--line);padding:16px 22px 18px;display:grid;gap:6px;font-size:13px}
.mf a{display:flex;justify-content:space-between;color:#555}
.mf a span:last-child{color:#222}

.cart{position:fixed;inset:0;z-index:70;background:var(--soft);display:flex;flex-direction:column;transform:translateX(100%);transition:transform .45s var(--ease);padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
.cart.on{transform:none}
.ch{display:flex;justify-content:space-between;align-items:center;height:72px;padding:0 22px;border-bottom:1px solid #e2e1dd}
.ch h3{margin:0;font:600 26px/1 var(--serif);text-transform:uppercase;letter-spacing:.01em}
.ch h3 small{font:400 14px var(--sans);color:#666;letter-spacing:0;margin-left:4px}
.cb{flex:1;overflow-y:auto;padding:30px 22px}
.ci{display:grid;grid-template-columns:62px 1fr auto;gap:14px;align-items:start;margin-bottom:22px}
.ci img{width:62px;height:72px;object-fit:contain;mix-blend-mode:multiply}
.ci b{font:700 14px/1.3 var(--sans);display:block;margin-top:2px}
.ci .rm{display:inline-block;margin-top:12px;font-size:13px;color:#666;text-decoration:underline;text-underline-offset:3px}
.ci .pr{font:700 14px/1.3 var(--sans);margin-top:2px;white-space:nowrap}
.cf{border-top:1px solid #e2e1dd;padding:22px 22px 18px}
.cf .row{display:flex;justify-content:space-between;align-items:baseline}
.cf .row span{font-size:16px;color:#555}
.cf .row b{font:700 16px var(--sans)}
.cf p{margin:8px 0 18px;font-size:11.5px;line-height:1.35;color:#555}
.cf .btn{text-transform:none;font:600 15px var(--sans)}
.cf .cont{display:block;text-align:center;margin-top:20px;font-size:14px;color:#555;text-decoration:underline;text-underline-offset:3px}
.empty{text-align:center;color:#666;padding-top:40px}

/* search */
.search{position:fixed;left:0;right:0;top:0;z-index:70;background:#fff;transform:translateY(-102%);transition:transform .45s var(--ease);max-height:90vh;overflow-y:auto;padding-top:env(safe-area-inset-top,0px)}
.search.on{transform:none}
.sbar{display:flex;align-items:center;gap:10px;height:72px;padding:0 22px;border-bottom:1px solid var(--line)}
.sbar input{flex:1;min-width:0;border:0;outline:none;font-size:17px;background:transparent;color:#111}
.sres{padding:22px var(--pad) 30px}

/* catalog */
.ctop{display:flex;justify-content:space-between;align-items:baseline;padding-top:22px}
.ctop h1{margin:0;font:600 34px/1 var(--serif);text-transform:uppercase;letter-spacing:.01em}
.ctop span{font-size:14px;color:#666}
.pills{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;margin-top:20px;padding-bottom:16px;border-bottom:1px solid var(--line)}
.pills::-webkit-scrollbar{display:none}
.pill{flex:none;height:40px;padding:0 16px;border-radius:20px;border:1px solid #dddcd8;font-size:14.5px;display:inline-flex;align-items:center;background:#fff;transition:background .2s,color .2s}
.pill.on{background:#111;color:#fff;border-color:#111}
.fbar{display:flex;justify-content:space-between;align-items:center;height:42px;border-bottom:1px solid var(--line);margin-bottom:28px}
.fbar button{display:flex;align-items:center;gap:8px;font:600 14.5px var(--sans)}
.sortw{position:relative;font-size:14px}
.sortw select{appearance:none;-webkit-appearance:none;border:0;background:transparent;font:inherit;font-size:14px;padding-right:20px;color:#222;cursor:pointer}
.sortw svg{position:absolute;right:0;top:50%;transform:translateY(-50%);pointer-events:none}

/* filter sheet */
.sheet{position:fixed;left:0;right:0;bottom:0;z-index:70;background:var(--soft);max-height:calc(100% - 76px);display:flex;flex-direction:column;transform:translateY(102%);transition:transform .45s var(--ease)}
.sheet.on{transform:none}
.sheet .ch{background:var(--soft)}
.sb{flex:1;overflow-y:auto;padding:22px 22px 10px}
.sb h4{margin:0 0 14px;font:600 14.5px var(--sans)}
.sb .grp{margin-bottom:26px}
.fp{display:flex;flex-wrap:wrap;gap:7px 8px}
.fp button{height:38px;padding:0 15px;border-radius:19px;border:1px solid #dddcd8;font-size:14px;transition:background .2s,color .2s}
.fp button.on{background:#111;color:#fff;border-color:#111}
.fs{display:flex;flex-wrap:wrap;gap:7px}
.fs button{min-width:38px;height:38px;padding:0 10px;border-radius:7px;border:1px solid #dddcd8;font-size:14px;transition:background .2s,color .2s}
.fs button.on{background:#111;color:#fff;border-color:#111}
.prh{display:flex;justify-content:space-between;align-items:baseline;border-top:1px solid #dddcd8;padding-top:22px}
.prh span{font-size:12.5px;color:#666}
.range{position:relative;height:30px;margin:14px 8px 0}
.range .tr{position:absolute;left:0;right:0;top:14px;height:2px;background:#111}
.range input{position:absolute;left:-8px;right:-8px;width:calc(100% + 16px);top:4px;margin:0;height:22px;background:transparent;-webkit-appearance:none;appearance:none;pointer-events:none}
.range input::-webkit-slider-thumb{-webkit-appearance:none;width:16px;height:16px;border-radius:50%;background:#fff;border:2px solid #111;pointer-events:auto;cursor:pointer}
.range input::-moz-range-thumb{width:13px;height:13px;border-radius:50%;background:#fff;border:2px solid #111;pointer-events:auto;cursor:pointer}
.tgl{display:flex;justify-content:space-between;align-items:center;border-top:1px solid #dddcd8;padding:16px 0 4px;font-size:14px}
.sw{width:44px;height:26px;border-radius:13px;background:#d0cfcb;position:relative;transition:background .25s}
.sw::after{content:"";position:absolute;left:3px;top:3px;width:20px;height:20px;border-radius:50%;background:#fff;transition:transform .25s var(--ease)}
.sw.on{background:#111}.sw.on::after{transform:translateX(18px)}
.sf{display:grid;grid-template-columns:.5fr 1fr;gap:12px;padding:14px 22px 18px;border-top:1px solid #e2e1dd}
.sf .ob{height:46px;border:1px solid #dddcd8;border-radius:7px;font:700 13.5px var(--sys);text-transform:uppercase;background:#fff}

/* product page */
.gal{position:relative;background:#f4f3f1}
.gtrack{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}
.gtrack::-webkit-scrollbar{display:none}
.gtrack div{flex:0 0 100%;scroll-snap-align:start;height:360px;padding:18px 0 34px}
.gtrack img{height:100%;width:100%;object-fit:contain}
.gdots{position:absolute;left:50%;bottom:16px;transform:translateX(-50%);display:flex;gap:5px}
.gdots i{width:5px;height:5px;border-radius:50%;background:#bdbcb8}
.gdots i.on{background:#111}
