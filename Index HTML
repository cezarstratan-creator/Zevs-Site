  background:linear-gradient(rgba(255,255,255,.34),rgba(255,255,255,.12) 45%,rgba(255,255,255,0));filter:blur(14px);mix-blend-mode:screen;opacity:0}
.i-dust{position:absolute;left:20%;top:3%;width:60%;height:55%}
.i-dark{position:absolute;inset:0;background:#000;pointer-events:none;opacity:1}
.i-word{display:none}
.i-vig{position:absolute;inset:0;pointer-events:none;background:radial-gradient(120% 85% at 50% 35%,transparent 45%,rgba(0,0,0,.55) 100%),linear-gradient(to bottom,rgba(0,0,0,.25),transparent 18%,transparent 52%,rgba(0,0,0,.72) 86%,rgba(0,0,0,.85))}
